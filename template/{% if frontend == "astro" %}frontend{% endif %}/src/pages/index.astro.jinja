---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../constants';
---

<BaseLayout>
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col justify-center gap-4 p-6">
    <h1 class="text-3xl font-bold text-brand">{SITE_TITLE}</h1>
    <p class="text-gray-600">{SITE_DESCRIPTION}</p>
{%- if backend in ['django', 'fastapi'] %}
    <p id="health-status" class="text-gray-500">Connexion au backend…</p>
{%- endif %}
  </main>
</BaseLayout>
{%- if backend in ['django', 'fastapi'] %}

<script>
  // Îlot minimal ([ASTRO-MODERNE]) : l'état de l'API est lu dans le navigateur, le reste est statique.
  const healthStatus = document.getElementById('health-status');

  async function showHealth(): Promise<void> {
    if (healthStatus === null) {
      return;
    }
    try {
      const response = await fetch('/api/health');
      const payload: unknown = await response.json();
      const isHealthy = response.ok && typeof payload === 'object' && payload !== null && 'status' in payload;
      healthStatus.textContent = isHealthy ? 'Backend joignable.' : 'Le backend répond mal.';
    } catch (error) {
      // [EXCEPTIONS] : backend injoignable, affiché comme tel.
      console.error('health.unreachable', error);
      healthStatus.textContent = 'Le backend ne répond pas : lancez-le avec kiln dev.';
    }
  }

  void showHealth();
</script>
{%- endif %}
