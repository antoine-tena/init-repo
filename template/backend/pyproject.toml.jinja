[project]
name = "{{ nom }}-backend"
version = "0.1.0"
requires-python = ">=3.14"
dependencies = [
    "dj-database-url>=3.1.2",
    "django>=6.1.2",
    "django-ninja>=1.7.1",
    "psycopg[binary]>=3.2,<4",
    "python-decouple>=3.8",
    "structlog>=26.1.0",
]

[dependency-groups]
dev = [
    "django-stubs>=6.1.2",
    "mypy>=2.4.0",
    "pytest>=9.1.1",
    "pytest-cov>=6.0",
    "pytest-django>=4.14.0",
    "ruff>=0.16.10",
]

[tool.ruff]
line-length = 100
target-version = "py314"

[tool.ruff.lint]
select = ["E", "F", "W", "I", "N", "UP", "B", "SIM", "RUF", "ANN"]

[tool.ruff.lint.per-file-ignores]
"*/migrations/*" = ["E501", "RUF012"]

[tool.mypy]
strict = true
plugins = ["mypy_django_plugin.main"]
exclude = ["migrations/"]

[tool.django-stubs]
django_settings_module = "config.settings"

[tool.pytest.ini_options]
DJANGO_SETTINGS_MODULE = "config.settings"
python_files = ["test_*.py"]

# python-decouple ne publie pas de types.
[[tool.mypy.overrides]]
module = ["decouple"]
ignore_missing_imports = true

[tool.coverage.run]
source = ["."]
omit = ["manage.py", "*/migrations/*", "tests/*", "config/asgi.py", "config/wsgi.py"]
