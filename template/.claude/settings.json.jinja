{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PROJET_NOM": "{{ nom }}",
    "PROJET_BACK": "{{ 'backend' if backend != 'aucun' else '' }}",
    "PROJET_FRONT": "{{ 'frontend' if frontend != 'aucun' else '' }}",
    "PROJET_ENV_TEST": "{{ 'backend/.env' if backend in ['django', 'fastapi'] else '' }}"
  },
{%- set plugins = (['pile-django@antoine'] if backend == 'django' else []) + (['pile-nuxt@antoine'] if frontend == 'nuxt' else []) %}
{%- if plugins %}
  "enabledPlugins": {
{%- for plugin in plugins %}
    "{{ plugin }}": true{{ "," if not loop.last }}
{%- endfor %}
  },
{%- endif %}
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)"
    ]
  }
}
