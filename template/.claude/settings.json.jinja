{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "PROJET_NOM": "{{ nom }}",
    "PROJET_BACK": "backend",
    "PROJET_FRONT": "frontend",
    "PROJET_ENV_TEST": "backend/.env"
  },
  "enabledPlugins": {
    "pile-django@antoine": true,
    "pile-nuxt@antoine": true
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)"
    ]
  }
}
